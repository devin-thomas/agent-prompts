{
  "name": "agent-prompts",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:public": "node scripts/audit-public.mjs",
    "check": "npm run format:check && npm run audit:public && npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lobehub/icons-static-svg": "1.95.1",
    "prettier": "3.9.10",
    "simple-icons": "16.35.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  },
  "description": "Working examples of clear, branded handoffs to coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devin-thomas/agent-prompts.git"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://agent-prompts.vercel.app/"
}
